<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Micro - Fresh Market</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --pink-50: #fdf2f8;
      --pink-200: #f9a8d4;
      --pink-500: #ec4899;
      --pink-600: #db2777;
      --gray-700: #374151;
      --gray-900: #111827;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Poppins", sans-serif;
      background: radial-gradient(circle at top left, #fee2e2 0, #fdf2f8 35%, #ffffff 80%);
      color: var(--gray-900);
      min-height: 100vh;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: #ffffffdd;
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(248, 113, 113, 0.2);
    }

    nav {
      max-width: 1100px;
      margin: 0 auto;
      padding: 10px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .logo-area {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
      color: inherit;
    }

    .logo-area img {
      height: 56px;
      width: auto;
      display: block;
    }

    .logo-text-main {
      font-weight: 800;
      font-size: clamp(1.1rem, 2.1vw, 1.4rem);
      letter-spacing: 0.05em;
      color: var(--gray-900);
    }

    .logo-text-sub {
      font-size: clamp(0.8rem, 1.6vw, 0.9rem);
      color: #6b7280;
    }

    .header-nav {
      list-style: none;
      display: flex;
      gap: 24px;
      align-items: center;
      flex-wrap: wrap;
    }

    .header-nav a {
      text-decoration: none;
      color: var(--gray-700);
      font-weight: 500;
      font-size: clamp(0.95rem, 1.7vw, 1.05rem);
      position: relative;
      padding-bottom: 3px;
    }
    @media (max-width: 768px) {
      nav {
        padding: 10px 14px;
        gap: 10px;
      }

      .logo-area img {
        height: 48px;
      }

      .header-nav {
        gap: 14px;
        font-size: 0.9rem;
      }
    }

    .header-nav a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: 0;
      width: 0;
      height: 2px;
      border-radius: 999px;
      background: linear-gradient(to right, var(--pink-500), var(--pink-600));
      transition: width 0.18s ease;
    }

    .header-nav a:hover::after {
      width: 100%;
    }

    main {
      max-width: 1100px;
      margin: 26px auto 40px;
      padding: 0 18px 40px;
    }

    /* product list grid + cards (used by product.ejs) */
    .product-list-grid {
      list-style: none;
      padding: 0;
      margin: 10px 0 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 20px;
    }

    .product-card {
      background: #fff;
      border-radius: 18px;
      padding: 14px 14px 16px;
      box-shadow: 0 12px 30px rgba(248, 113, 113, 0.16);
      border: 1px solid rgba(248, 113, 113, 0.16);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .product-image-wrap {
      border-radius: 14px;
      overflow: hidden;
      background: #ffe4ef;
      height: 150px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .product-image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .product-name a {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--gray-900);
      text-decoration: none;
      margin-top: 4px;
      display: inline-block;
    }

    .product-meta {
      font-size: 0.85rem;
      color: #6b7280;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 10px;
    }

    .product-price {
      font-size: 1.1rem;
      font-weight: 700;
      color: #16a34a;
    }

    .add-to-cart-form {
      margin-top: 6px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      font-size: 0.9rem;
    }

    .form-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .add-to-cart-form label {
      font-weight: 500;
      color: #4b5563;
    }

    .add-to-cart-form input[type="number"] {
      width: 70px;
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid #e5e7eb;
      text-align: center;
      outline: none;
    }

    .add-to-cart-form input[type="number"]:focus {
      border-color: var(--pink-500);
      box-shadow: 0 0 0 3px rgba(236, 72, 153, 0.2);
    }

    .btn-primary {
      border: none;
      border-radius: 999px;
      padding: 9px 16px;
      background: linear-gradient(to right, var(--pink-500), var(--pink-600));
      color: #fff;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 10px 20px rgba(236, 72, 153, 0.35);
      width: 100%;
    }

    .btn-primary:hover {
      filter: brightness(1.05);
    }

    .page-title {
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 4px;
      color: var(--gray-900);
    }

    .page-subtitle {
      font-size: 0.95rem;
      color: #6b7280;
      margin-bottom: 16px;
    }
  </style>
</head>

<body>
  <header>
    <nav>
      <a href="/" class="logo-area">
        <img src="/logo.png" alt="Micro logo">
        <div>
          <div class="logo-text-main">micro</div>
          <div class="logo-text-sub">YOUR FAT &amp; YOUR CHOICE</div>
        </div>
      </a>

      <ul class="header-nav">
        <li><a href="/">Home</a></li>
        <li><a href="/product">Shop</a></li>
        <li><a href="/login">Login</a></li>
        <li><a href="/cart">Cart</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <%- body %>
  </main>

  <script src="/delete_cart.js"></script>
  <script src="/increase_btn.js"></script>
  <script src="/decrease_btn.js"></script>
</body>
</html>