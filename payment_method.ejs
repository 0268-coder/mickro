<% layout('layout') %>

<section style="max-width: 900px; margin: 0 auto; padding: 20px;">
  <h1 style="font-size: 2rem; font-weight: 700; color: #be185d; margin-bottom: 20px;">
    Choose Payment Method
  </h1>

  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;">
    <% get_payment_method.forEach(method => { %>
      <a 
        href="/payment_method/type/<%= method.Payment_Method_ID %>"
        style="
          display: flex;
          align-items: center;
          gap: 14px;
          padding: 18px;
          background: #fff;
          border-radius: 16px;
          text-decoration: none;
          color: #111;
          box-shadow: 0 8px 20px rgba(248, 113, 113, 0.18);
          transition: transform 0.2s, box-shadow 0.2s;
        "
        onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 12px 26px rgba(248,113,113,0.28)'"
        onmouseout="this.style.transform='none'; this.style.boxShadow='0 8px 20px rgba(248,113,113,0.18)'"
      >
        <div 
          style="
            width: 52px;
            height: 52px;
            border-radius: 12px;
            background: #ffe4ec;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.6rem;
          "
        >
          <% if (method.Method_Type.toLowerCase().includes('cash')) { %>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#be185d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="6" width="20" height="12" rx="2" ry="2"></rect>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          <% } else if (method.Method_Type.toLowerCase().includes('credit')) { %>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#be185d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
              <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
          <% } else { %>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#be185d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16v16H4z"></path>
              <path d="M4 9h16"></path>
            </svg>
          <% } %>
        </div>

        <div style="font-size: 1.2rem; font-weight: 600; color: #be185d;">
          <%= method.Method_Type.replace('_', ' ') %>
        </div>
      </a>
    <% }) %>
  </div>
</section>
