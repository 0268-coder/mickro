
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mickro • Checkout</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        blush: '#FBD7D7',
                        rose: '#FCE5E5',
                        cherry: '#D94F5C',
                        cherryDark: '#BE3B48',
                        label: '#C64C5A',
                        placeholder: '#F5B8B8'
                    },
                    fontFamily: {
                        nunito: ['"Nunito"', 'sans-serif'],
                        pacifico: ['"Pacifico"', 'cursive']
                    },
                    boxShadow: {
                        soft: '0 20px 60px rgba(217, 79, 92, 0.15)'
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Pacifico&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen bg-blush font-nunito">
    <!-- Top Navigation -->
    <header class="sticky top-0 z-10 bg-blush">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
            <a href="/cart" class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-rose hover:bg-rose/80 transition">
                <svg class="w-6 h-6 text-cherry" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </a>
            <h1 class="text-lg sm:text-xl font-bold text-cherry">Checkout</h1>
            <div class="w-10"></div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 pb-32">
        <% if (message) { %>
            <div class="mb-4 bg-white border-l-4 border-cherryDark rounded-2xl px-4 py-3 text-cherryDark">
                <p class="text-sm"><%= message %></p>
            </div>
        <% } %>

        <% if (cartItems && cartItems.length > 0) { %>
        <div class="grid gap-4 lg:grid-cols-3">
            <!-- Left Column: Contact & Delivery -->
            <div class="space-y-4 lg:col-span-2">
                <!-- Contact Info Card -->
                <div class="bg-white rounded-2xl shadow-md p-4">
                    <h2 class="text-xl font-bold text-cherry mb-4">Contact Information</h2>
                    <div class="space-y-3">
                        <div>
                            <label class="block text-sm font-semibold text-label mb-1" for="fullName">Full name</label>
                            <input 
                                type="text" 
                                id="fullName" 
                                name="fullName" 
                                form="checkout-form"
                                required
                                class="w-full rounded-xl border border-rose/50 bg-rose/20 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cherryDark"
                                placeholder="Your name"
                                value="<%= typeof locals.userFullName !== 'undefined' ? locals.userFullName : '' %>"
                            >
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-label mb-1" for="phone">Phone number</label>
                            <input 
                                type="tel" 
                                id="phone" 
                                name="phone" 
                                form="checkout-form"
                                required
                                class="w-full rounded-xl border border-rose/50 bg-rose/20 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cherryDark"
                                placeholder="081-234-5678"
                                value="<%= typeof locals.userPhone !== 'undefined' ? locals.userPhone : '' %>"
                            >
                        </div>
                    </div>
                </div>

                <!-- Delivery Info Card -->
                <div class="bg-white rounded-2xl shadow-md p-4">
                    <div class="flex items-center justify-between">
                        <h2 class="text-xl font-bold text-cherry">Delivery Address</h2>
                        <a href="/address" class="text-xs sm:text-sm text-cherry underline hover:text-cherryDark">
                            Change
                        </a>
                    </div>
                    <div class="mt-3 flex items-start gap-2 text-gray-600">
                        <svg class="w-5 h-5 mt-0.5 text-cherry" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                        </svg>
                        <p class="text-sm leading-relaxed">
                            <%= typeof userAddress !== 'undefined' ? userAddress : 'Sirindhorn International Institute of Technology' %>
                        </p>
                    </div>

                    <!-- Hidden address field for POST -->
                    <textarea 
                        name="address" 
                        id="address"
                        form="checkout-form"
                        class="hidden"
                    ><%= typeof userAddress !== 'undefined' ? userAddress : 'Sirindhorn International Institute of Technology' %></textarea>
                </div>

                <!-- Payment Method Card -->
                <div class="bg-white rounded-2xl shadow-md p-4">
                    <div class="flex items-center justify-between">
                        <h2 class="text-xl font-bold text-cherry">Payment Method</h2>
                        <a href="/payment_method" class="text-xs sm:text-sm text-cherry underline hover:text-cherryDark">
                            Change
                        </a>
                    </div>
                    <div class="mt-3 flex items-center gap-2 text-gray-600">
                        <svg class="w-5 h-5 text-cherry" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                        </svg>
                        <%
                          const formattedPayment = (typeof payment_type !== 'undefined' && payment_type !== "")
                            ? payment_type.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase())
                            : 'Select Payment Method';
                        %>
                        <span class="text-sm"><%= formattedPayment %></span>
                    </div>

                    <!-- Hidden payment method field for POST -->
                    <input 
                        type="hidden" 
                        name="paymentMethod" 
                        form="checkout-form"
                        value="<%= typeof payment_type !== 'undefined' && payment_type !== '' ? payment_type : '' %>"
                    >
                </div>
            </div>

            <!-- Right Column: Order Summary -->
            <div class="space-y-4">
                <div class="bg-white rounded-2xl shadow-md p-4">
                    <h2 class="text-xl font-bold text-cherry mb-4">Order Summary</h2>

                    <div class="space-y-3 max-h-64 overflow-y-auto pr-1">
                        <% cartItems.forEach(item => { %>
                            <div class="flex gap-3 border-b border-rose/20 pb-3 last:border-0 last:pb-0">
                                <div class="w-14 h-14 rounded-xl bg-rose/30 flex-shrink-0 overflow-hidden">
                                    <%
                                        let imgPath = "/images/logo.png";
                                        const lower = (item.name || "").toLowerCase();
                                        
                                         if(item.image != null && item.image != ""){
                                        imgPath = item.image
                                    }
                                    %>
                                    <img src="<%= imgPath %>" alt="<%= item.name %>" class="w-full h-full object-cover">
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex justify-between items-start gap-2">
                                        <div class="min-w-0">
                                            <h3 class="text-sm font-semibold text-cherry truncate"><%= item.name %></h3>
                                            <p class="text-xs text-gray-500 mt-0.5">
                                                ฿<%= item.price.toFixed(2) %> × <%= item.qty %>
                                            </p>
                                        </div>
                                        <p class="text-sm font-bold text-cherry">
                                            ฿<%= (item.itemTotal ? item.itemTotal : (item.price * item.qty).toFixed(2)) %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <div class="mt-4 pt-4 border-t border-rose/30 space-y-2">
                        <div class="flex justify-between text-sm text-gray-600">
                            <span>Subtotal</span>
                            <span>฿ <%= subtotal %></span>
                        </div>
                        <div class="flex justify-between text-sm text-gray-600">
                            <span>Delivery fee</span>
                            <span>฿ <%= deliveryFee %></span>
                        </div>
                        <div class="flex justify-between items-center mt-2">
                            <span class="text-cherry font-bold text-lg">Total</span>
                            <span class="text-cherry font-bold text-lg">฿ <span id="summary-total"><%= total %></span></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% } else { %>
            <div class="bg-white rounded-2xl shadow-md p-8 text-center">
                <p class="text-gray-500"><%= message || 'Your cart is empty' %></p>
                <a href="/product" class="inline-block mt-4 px-4 py-2 rounded-xl bg-cherryDark text-white text-sm font-semibold hover:bg-cherry">
                    Back to shop
                </a>
            </div>
        <% } %>
    </main>

    <% if (cartItems && cartItems.length > 0) { %>
    <!-- Checkout Form (hidden, but connected to inputs) -->
    <form id="checkout-form" action="/checkout" method="POST"></form>

    <!-- Bottom Place Order Button -->
    <div class="fixed bottom-0 left-0 right-0 bg-rose border-t border-rose/50 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <button 
                type="submit" 
                form="checkout-form"
                class="w-full bg-cherryDark hover:bg-cherry text-white font-bold py-4 px-6 rounded-2xl transition flex items-center justify-between"
            >
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-white rounded-full flex items-center justify-center">
                        <span class="text-cherry font-bold text-sm">
                            <%= cartItems.length %>
                        </span>
                    </div>
                    <span class="text-lg">Place Order</span>
                </div>
                <span class="text-lg">
                    ฿ <span id="checkout-total"><%= total || '0.00' %></span>
                </span>
            </button>
        </div>
    </div>
    <% } %>
</body>
</html>
