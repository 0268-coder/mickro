<%- layout('layout') %>

<% cart.forEach(element => {%>
    <div class="cart-item" id="item<%= element.id %>">
        <p>cart name: <%= element.name %> Qauntity: 
            <span class="quantity-display"><%= element.qty %></span>
        </p>

        <button class="increase-btn" data-item-id="<%=element.id %>">+</button>
        <button class="decrease-btn" data-item-id="<%=element.id %>">-</button>
        <button class="delete-btn" data-item-id="<%= element.id %>">Delete</button>
    </div>
<%}); %>

<a href="/payment_method">Payment Method:</a>
<% if(payment_type){ %>
    <%= payment_type %>
<%}%>
<br>
<p></p>
Total Price = <span id="total-price"><%= total %></span>
<from href="/checkout" method="POST">
    <input type="submit" name="checkout-btn" value="checkout">
</from>