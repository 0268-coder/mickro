<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mickro • Home</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        blush: '#FBD7D7',
                        rose: '#FCE5E5',
                        cherry: '#D94F5C',
                        cherryDark: '#BE3B48',
                        label: '#C64C5A',
                        placeholder: '#F5B8B8'
                    },
                    fontFamily: {
                        nunito: ['"Nunito"', 'sans-serif'],
                        pacifico: ['"Pacifico"', 'cursive']
                    },
                    boxShadow: {
                        soft: '0 20px 60px rgba(217, 79, 92, 0.15)'
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Pacifico&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="min-h-screen bg-blush font-nunito">
    <header>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="mb-4">
                <a href="/address" class="inline-flex items-center gap-2 text-cherry hover:text-cherryDark transition">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                    </svg>
                    <span class="font-bold text-lg"><%= typeof userAddress !== 'undefined' && userAddress != "" ? userAddress : 'Select Location' %></span>
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                    </svg>
                </a>
            </div>
            
            <div class="relative flex items-center">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none z-10">
                    <svg class="h-5 w-5 text-cherry" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </div>
                <div class="absolute inset-y-0 left-10 w-px bg-rose z-10"></div>
                <input 
                    type="text" 
                    id="search-input"
                    placeholder="Look what you want..." 
                    value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                    class="flex-1 pl-14 pr-20 py-3 rounded-2xl bg-white border border-rose/30 text-cherry placeholder:text-placeholder focus:outline-none focus:ring-2 focus:ring-cherry focus:border-transparent"
                >
                <button 
                    type="button"
                    id="search-btn"
                    class="absolute right-2 bg-cherry hover:bg-cherryDark text-white px-4 py-2 rounded-xl font-semibold transition z-10"
                >
                    Search
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-24">

        <section>
            <h2 class="text-2xl font-bold text-cherry mb-6">SUGGESTIONS</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                <% product.forEach(element => { %>
                    <div class="bg-white rounded-2xl shadow-md overflow-hidden cursor-pointer hover:shadow-lg transition">
                        <a href="product/<%= element.Product_ID %>">
                            <div class="aspect-square bg-rose/30 flex items-center justify-center">
                                <%
                                  let imgPath = "/images/logo.png";
                                  const name = (element.Product_Name || "").toLowerCase();

                                  if (name.includes("seabass") || name.includes("fish")) imgPath = "/images/seabass.png";
                                  else if (name.includes("pork")) imgPath = "/images/pork-loin.png";
                                  else if (name.includes("morning glory") || name.includes("pak boong") || name.includes("kangkung")) imgPath = "/images/morning-glory.png";
                                  else if (name.includes("rice") || name.includes("jasmine")) imgPath = "/images/jasmine-rice.png";
                                  else if (name.includes("egg")) imgPath = "/images/cage-free-eggs.png";
                                %>
                                <img src="<%= imgPath %>" alt="<%= element.Product_Name %>" class="w-full h-full object-cover">
                            </div>
                            <div class="p-4">
                                <p class="text-cherry font-semibold text-center mb-2"><%= element.Product_Name %></p>
                                <p class="text-cherry font-bold text-center text-lg">$<%= element.Product_Price %></p>
                            </div>
                        </a>
                        <form action="/cart" method="POST" class="px-4 pb-4">
                            <input type="hidden" value="<%= element.Product_ID %>" name="Product_ID">
                            <input type="hidden" value="<%= element.Product_Name %>" name="Product_Name">
                            <input type="hidden" value="<%= element.Product_Price %>" name="Product_Price">
                            <input type="hidden" name="quantity" value="1">
                            <button type="submit" class="w-full bg-cherry hover:bg-cherryDark text-white font-semibold py-2 px-4 rounded-xl transition">
                                Add to Cart
                            </button>
                        </form>
                    </div>
                <% }); %>
            </div>
        </section>
    </main>

    <nav class="fixed bottom-0 left-0 right-0 bg-rose border-t border-rose/50 shadow-lg z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-around items-center py-4">
                <a href="/" class="flex flex-col items-center text-cherry hover:text-cherryDark transition transform hover:scale-110">
                    <div class="w-8 h-8 flex items-center justify-center mb-1">
                        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                        </svg>
                    </div>
                    <span class="text-[10px] font-bold uppercase tracking-wide">Home</span>
                </a>
                
                <a href="/cart" class="flex flex-col items-center text-cherry hover:text-cherryDark transition transform hover:scale-110">
                    <div class="w-8 h-8 flex items-center justify-center mb-1">
                        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
                        </svg>
                    </div>
                    <span class="text-[10px] font-bold uppercase tracking-wide">Cart</span>
                </a>
                
                <a href="/login" class="flex flex-col items-center text-cherry hover:text-cherryDark transition transform hover:scale-110">
                    <div class="w-8 h-8 flex items-center justify-center mb-1">
                        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <span class="text-[10px] font-bold uppercase tracking-wide">Profile</span>
                </a>
            </div>
        </div>
    </nav>

    <script>
        // Search functionality
        const searchInput = document.getElementById('search-input');
        const searchBtn = document.getElementById('search-btn');

        function performSearch() {
            const query = searchInput.value.trim();
            if (query) {
                window.location.href = `/product?search=${encodeURIComponent(query)}`;
            } else {
                window.location.href = '/';
            }
        }

        // Search button click
        searchBtn.addEventListener('click', performSearch);

        // Enter key press in search input
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                performSearch();
            }
        });
    </script>
</body>
</html>