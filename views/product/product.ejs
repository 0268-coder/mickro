<%- layout('layout') %>
    <h1>Product List</h1>
    
    <!-- EJS Template Loop - The server will insert the data here -->
    <ul class="product-list-grid">
        <% product.forEach(element => { %>
            <!-- Product Card -->
            <div class="product-card">
                
                <!-- Product Name Link -->
                <li class="product-name">
                    <a href="/product/<%= element.Product_ID %>"><%= element.Product_Name %></a>
                </li>
                
                <!-- Add to Cart Form -->
                <form action="/cart" method="POST" class="add-to-cart-form">
                    
                    <!-- Hidden inputs -->
                    <input type="hidden" value="<%= element.Product_ID %>" name="Product_ID">
                    <input type="hidden" value="<%= element.Product_Price %>" name="Product_Price">
                    
                    <!-- Form Row for Quantity and Price -->
                    <div class="form-row">
                        <label for="quantity">Quantity</label>
                        <input type="number" name="quantity" value="1" min="1">
                        <!-- Display Price -->
                        <span class="product-price">$<%= element.Product_Price %></span>
                    </div>

                    <!-- Submit Button -->
                    <input type="submit" value="Add to Cart">
                </form>
            </div>
        <% }); %>
    </ul>