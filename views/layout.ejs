<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Micrko</title>
    <style>
        .header-nav {
            list-style: none;
            padding: 10px 0;
            background-color: #9b6f6f;
            margin: 0;
            display: flex;
            justify-content: flex-end; /* Pushes links to the right */
        }
        .header-nav li {
            margin-right: 20px;
        }
        .header-nav a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }
        h1 {
            text-align: center;
            font-size: 2.5rem;
            color: #1a202c;
            margin-bottom: 40px;
            font-weight: 700;
        }

            /* Product List Grid Container */
            /* Product List Grid Container (Changed from ID to Class) */
            .product-list-grid {
        display: grid;
        /* Create responsive columns:
        - minmax(300px, 1fr) means each column is at least 300px wide
        - auto-fit fills the row with as many columns as fit
        */
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem; /* Space between cards */
        list-style-type: none; /* Remove <ul> bullets */
        padding: 0; /* Remove <ul> default padding */
    }

    /* === Product Card === */
    .product-card {
        background-color: #ffffff;
        border-radius: 12px;
        /* Soft, professional shadow */
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.08);
        border: 1px solid #e0e0e0;
        padding: 1.5rem;
        /* Use flexbox to organize card content */
        display: flex;
        flex-direction: column;
        height: 100%; /* Ensures cards in a row are the same height */
        /* Smooth transitions for hover effect */
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .product-card:hover {
        /* "Lift" the card on hover */
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.12);
    }

    /* === Product Name === */
    .product-name {
        list-style-type: none; /* Remove <li> bullet (see note below) */
        margin-bottom: 1rem;
        font-size: 1.25rem;
        font-weight: 600;
    }

    .product-name a {
        text-decoration: none;
        color: #34495e; /* Darker text for name */
        transition: color 0.3s ease;
    }

    .product-name a:hover {
        color: #1abc9c; /* Accent color */
    }

    /* === Add to Cart Form === */
    .add-to-cart-form {
        display: flex;
        flex-direction: column;
        gap: 1rem; /* Space between form row and button */
        /* This pushes the form to the bottom of the card */
        margin-top: auto;
    }

    /* === Form Row (Quantity & Price) === */
    .form-row {
        display: flex;
        justify-content: space-between; /* Pushes price to the right */
        align-items: center; /* Vertically aligns label, input, and price */
        margin-top: 1rem;
    }

    .form-row label {
        font-size: 0.9rem;
        color: #555;
        margin-right: 0.5rem;
    }

    .form-row input[type="number"] {
        width: 60px;
        padding: 0.5rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        text-align: center;
        font-size: 1rem;
        /* Removes default spinner arrows in some browsers */
        -moz-appearance: textfield;
    }
    .form-row input[type="number"]::-webkit-inner-spin-button,
    .form-row input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .product-price {
        font-size: 1.3rem;
        font-weight: 700;
        color: #16a085; /* Slightly darker accent */
    }

    /* === "Add to Cart" Button === */
    input[type="submit"] {
        background-color: #1abc9c; /* Bright, attractive accent color */
        color: white;
        border: none;
        padding: 0.75rem;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.2s ease;
        width: 100%;
    }

    input[type="submit"]:hover {
        background-color: #16a085; /* Darker shade on hover */
        transform: scale(1.02); /* Slight grow effect */
    }
    </style>
</head>
<body>
    <header>
        <nav>
            <ul class="header-nav">
                <li><a href="/">Home</a></li>
                <li><a href="/login">Login</a></li>
                <li><a href="/cart">Cart</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <%- body %>
    </main>
    <script src="/delete_cart.js"></script>
    <script src="/increase_btn.js"></script>
    <script src="/decrease_btn.js"></script>
</body>
</html>