<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Micro - Fresh Market</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        blush: '#FBD7D7',
                        rose: '#FCE5E5',
                        cherry: '#D94F5C',
                        cherryDark: '#BE3B48',
                        label: '#C64C5A',
                        placeholder: '#F5B8B8'
                    },
                    fontFamily: {
                        nunito: ['"Nunito"', 'sans-serif'],
                        pacifico: ['"Pacifico"', 'cursive']
                    },
                    boxShadow: {
                        soft: '0 20px 60px rgba(217, 79, 92, 0.15)'
                    }
                }
            }
        }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Pacifico&display=swap" rel="stylesheet">
</head>

<body class="min-h-screen bg-blush font-nunito pb-24 md:pb-0 text-gray-800">

    <header class="sticky top-0 z-50 bg-blush/90 backdrop-blur-md border-b border-rose/50 shadow-sm">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between">
            
            <a href="/" class="flex items-center gap-3 group">
                <div class="bg-white p-1.5 rounded-xl shadow-sm group-hover:rotate-3 transition duration-300">
                    <img src="/images/logo.png" alt="Micro logo" class="h-10 w-auto">
                </div>
                <div class="flex flex-col">
                    <div class="text-2xl font-extrabold text-cherry tracking-tight leading-none group-hover:text-cherryDark transition">micro</div>
                    <div class="text-[0.65rem] font-bold text-cherry/70 tracking-[0.15em] uppercase">Your Fat & Your Choice</div>
                </div>
            </a>

            <ul class="hidden md:flex items-center gap-8">
                <li>
                    <a href="/" class="text-cherry font-bold text-lg hover:text-cherryDark transition relative group">
                        Home
                        <span class="absolute -bottom-1 left-0 w-0 h-1 bg-cherry rounded-full transition-all group-hover:w-full"></span>
                    </a>
                </li>
                <li>
                    <a href="/product" class="text-cherry font-bold text-lg hover:text-cherryDark transition relative group">
                        Shop
                        <span class="absolute -bottom-1 left-0 w-0 h-1 bg-cherry rounded-full transition-all group-hover:w-full"></span>
                    </a>
                </li>
                <li>
                    <a href="/login" class="text-cherry font-bold text-lg hover:text-cherryDark transition relative group">
                        Login
                        <span class="absolute -bottom-1 left-0 w-0 h-1 bg-cherry rounded-full transition-all group-hover:w-full"></span>
                    </a>
                </li>
                <li>
                    <a href="/cart" class="flex items-center gap-2 bg-cherry text-white px-5 py-2 rounded-full font-bold hover:bg-cherryDark transition shadow-md hover:shadow-lg transform hover:-translate-y-0.5">
                        <span>Cart</span>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                    </a>
                </li>
            </ul>
        </nav>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <%- body %>
    </main>

    <nav class="md:hidden fixed bottom-0 left-0 right-0 bg-rose border-t border-rose/50 shadow-[0_-4px_20px_rgba(0,0,0,0.05)] z-50">
        <div class="flex justify-around items-center py-4 px-2">
            <a href="/" class="flex flex-col items-center text-cherry hover:text-cherryDark transition transform active:scale-95">
                <svg class="w-7 h-7 mb-1" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                </svg>
                <span class="text-[10px] font-bold uppercase tracking-wide">Home</span>
            </a>
            
            <a href="/product" class="flex flex-col items-center text-cherry hover:text-cherryDark transition transform active:scale-95">
                <svg class="w-7 h-7 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2H4V6zm10 0h6v2h-6V6zm0 0V4a2 2 0 00-2-2h-2a2 2 0 00-2 2v2m0 0h6zM3 10h18M5 10v10a1 1 0 001 1h12a1 1 0 001-1V10" />
                </svg>
                <span class="text-[10px] font-bold uppercase tracking-wide">Shop</span>
            </a>
            
            <a href="/cart" class="flex flex-col items-center text-cherry hover:text-cherryDark transition transform active:scale-95">
                <svg class="w-7 h-7 mb-1" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
                </svg>
                <span class="text-[10px] font-bold uppercase tracking-wide">Cart</span>
            </a>
            
            <a href="/login" class="flex flex-col items-center text-cherry hover:text-cherryDark transition transform active:scale-95">
                <svg class="w-7 h-7 mb-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                </svg>
                <span class="text-[10px] font-bold uppercase tracking-wide">Profile</span>
            </a>
        </div>
    </nav>

    <script src="/delete_cart.js"></script>
    <script src="/increase_btn.js"></script>
    <script src="/decrease_btn.js"></script>
</body>
</html>