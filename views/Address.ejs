<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mickro • Delivery Address</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        blush: '#FBD7D7',
                        rose: '#FCE5E5',
                        cherry: '#D94F5C',
                        cherryDark: '#BE3B48',
                        label: '#C64C5A',
                        placeholder: '#F5B8B8'
                    },
                    fontFamily: {
                        nunito: ['"Nunito"', 'sans-serif'],
                        pacifico: ['"Pacifico"', 'cursive']
                    },
                    boxShadow: {
                        soft: '0 20px 60px rgba(217, 79, 92, 0.15)'
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Pacifico&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="min-h-screen bg-blush font-nunito text-cherry">
    <% if (typeof message !== 'undefined' && message) { %>
    <div id="popup-message" class="fixed top-6 left-1/2 transform -translate-x-1/2 z-50 w-full max-w-md px-4 transition-opacity duration-500 ease-in-out">
        <div class="<%= success ? 'bg-green-600 shadow-[0_8px_30px_rgba(34,197,94,0.4)] border-green-600/20' : 'bg-red-600 shadow-[0_8px_30px_rgba(220,38,38,0.4)] border-red-600/20' %> text-white rounded-2xl px-6 py-4 backdrop-blur-sm border">
            <div class="flex items-center gap-3">
                <div class="flex-shrink-0 w-5 h-5 rounded-full bg-white/20 flex items-center justify-center">
                    <% if (success) { %>
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    <% } else { %>
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                    <% } %>
                </div>
                <p class="font-medium text-sm flex-1"><%= message %></p>
            </div>
        </div>
    </div>
    <% } %>
    <div class="flex min-h-screen flex-col gap-10">
        <header class="px-6 pt-6">
            <a href="/" class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-rose shadow-soft hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cherry focus-visible:ring-offset-2 focus-visible:ring-offset-blush transition">
                <span class="text-cherry text-2xl leading-none">&larr;</span>
            </a>
        </header>

        <main class="px-6 pb-16">
            <div class="mx-auto w-full max-w-xl rounded-[32px] bg-rose p-8 text-center shadow-soft">
                <h1 class="text-4xl font-extrabold text-cherry mb-6">Delivery Address</h1>
                <form action="/address" method="POST" class="space-y-6">
                    <div class="text-left">
                        <label for="address" class="block text-lg font-semibold text-label mb-3">Please enter your address</label>
                        <textarea id="address" name="address" rows="5" placeholder="Enter your address" class="w-full rounded-3xl border-none bg-white/90 px-6 py-4 text-base text-cherry placeholder:text-placeholder shadow-inner focus:outline-none focus:ring-2 focus:ring-cherry"><%= address %></textarea>
                    </div>
                    <button type="submit" class="mx-auto inline-flex w-40 items-center justify-center rounded-full bg-cherry px-6 py-3 text-lg font-semibold text-white shadow-soft transition hover:bg-cherryDark focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-rose">Save</button>
                </form>
            </div>
        </main>
    </div>
    <script>
        const popup = document.getElementById('popup-message');
        if (popup) {
            setTimeout(() => {
                popup.style.opacity = '0';
                popup.style.transition = 'opacity 0.5s ease-in-out';
                setTimeout(() => {
                    popup.remove();
                }, 500);
            }, 2000);
        }
    </script>
</body>
</html>