<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Mickro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        blush: '#FBD7D7',
                        rose: '#FCE5E5',
                        cherry: '#D94F5C',
                        cherryDark: '#BE3B48',
                        label: '#C64C5A',
                        placeholder: '#F5B8B8',
                        adminPink: '#EC4899',
                        adminRed: '#DC2626'
                    },
                    fontFamily: {
                        nunito: ['"Nunito"', 'sans-serif'],
                        pacifico: ['"Pacifico"', 'cursive']
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Pacifico&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <style>
        .content-section {
            display: none;
        }
        .content-section.active {
            display: block;
        }
        .nav-link.active {
            background-color: #EC4899;
            color: white;
        }
    </style>
</head>
<body class="min-h-screen bg-gray-50 font-nunito">
    <div class="flex h-screen overflow-hidden">
        <!-- Left Sidebar -->
        <aside class="w-64 bg-gray-100 flex flex-col">
            <!-- Logo Section -->
            <div class="p-8 border-b border-gray-200">
                <div class="flex flex-col items-center justify-center">
                    <div class="mb-3 transform hover:scale-105 transition-transform duration-300">
                        <img src="/images/logo_admin_micro.png" alt="Admin Logo" class="w-32 h-28 object-contain drop-shadow-lg">
                    </div>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="flex-1 p-4 space-y-2">
                <a href="#" onclick="showSection('dashboard'); return false;" class="nav-link active flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-200 transition" id="nav-dashboard">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                    <span class="font-medium">Dashboard</span>
                </a>
                <a href="/admin/product" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-200 transition" id="nav-products">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                    <span class="font-medium">Products</span>
                </a>
                <a href="#" onclick="showSection('orders'); return false;" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-200 transition" id="nav-orders">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    <span class="font-medium">Orders</span>
                </a>
                <a href="#" onclick="showSection('payment-method'); return false;" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-200 transition" id="nav-payment-method">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                    </svg>
                    <span class="font-medium">Payment Method</span>
                </a>
                <a href="#" onclick="showSection('user-status'); return false;" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-200 transition" id="nav-user-status">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    <span class="font-medium">User Status</span>
                </a>
            </nav>

            <!-- Logout -->
            <div class="p-4 border-t border-gray-200">
                <a href="/login" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-200 transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                    <span class="font-medium">Logout</span>
                </a>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 overflow-y-auto bg-white">
            <!-- Dashboard Section -->
            <div id="dashboard" class="content-section active p-8">
                <h1 class="text-3xl font-bold text-gray-800 mb-2">Welcome, Admin!</h1>
                <p class="text-gray-600 mb-8">Here's a summary of your store's activity.</p>

                <!-- Summary Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                    <!-- Total Revenue Card -->
                    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-100">
                        <h3 class="text-gray-600 text-sm font-medium mb-2">Total Revenue</h3>
                        <p class="text-3xl font-bold text-adminPink mb-1">฿<%= Number(totalRevenue || 0).toFixed(2) %></p>
                        <p class="text-sm text-green-600">+฿<%= Number(todayRevenue || 0).toFixed(2) %> today</p>
                    </div>

                    <!-- All Orders Card -->
                    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-100">
                        <h3 class="text-gray-600 text-sm font-medium mb-2">All Orders</h3>
                        <p class="text-3xl font-bold text-adminPink mb-1"><%= totalOrders || 0 %></p>
                        <p class="text-sm text-green-600">+<%= todayOrders || 0 %> new today</p>
                    </div>

                    <!-- All Users Card -->
                    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-100">
                        <h3 class="text-gray-600 text-sm font-medium mb-2">All Users</h3>
                        <p class="text-3xl font-bold text-adminPink mb-1"><%= totalUsers || 0 %></p>
                    </div>

                    <!-- Products Card -->
                    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-100">
                        <h3 class="text-gray-600 text-sm font-medium mb-2">Products</h3>
                        <p class="text-3xl font-bold text-adminPink mb-1"><%= totalProducts || 0 %></p>
                        <p class="text-sm text-gray-500">active products</p>
                    </div>
                </div>
            </div>

            <!-- Products Section -->
            <div id="products" class="content-section p-8">
                <div class="flex justify-between items-center mb-6">
                    <h1 class="text-3xl font-bold text-gray-800">Manage Products</h1>
                    <button class="bg-adminPink text-white px-6 py-2 rounded-lg font-semibold hover:bg-pink-600 transition flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                        </svg>
                        Add New Product
                    </button>
                </div>

                <!-- Products Table -->
                <div class="bg-white rounded-lg shadow-md overflow-hidden border border-gray-100">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">PRODUCT</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">PRICE</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">STOCK</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">STATUS</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <!-- Empty state -->
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                                    No products available
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Orders Section -->
            <div id="orders" class="content-section p-8">
                <h1 class="text-3xl font-bold text-gray-800 mb-6">Manage Orders</h1>

                <!-- Orders Table -->
                <div class="bg-white rounded-lg shadow-md overflow-x-auto border border-gray-100">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">ORDER ID</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">NAME</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">PHONE NUMBER</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">ADDRESS</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">ORDER DATE</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">PAYMENT METHOD</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">TOTAL PRICE</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
                                <% orders.forEach(order => { %>
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">#<%= order.Order_ID %></td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= order.Full_Name %></td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= order.Phone %></td>
                                        <td class="px-6 py-4 text-sm text-gray-700 max-w-xs truncate"><%= order.Address %></td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                            <%= new Date(order.Order_Date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                            <span class="<%= order.Payment_Method === 'Cash' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800' %> px-2 py-1 rounded-full text-xs font-semibold">
                                                <%= order.Payment_Method || 'N/A' %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">฿<%= Number(order.Order_Total).toFixed(2) %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="px-6 py-12 text-center text-gray-500">
                                        No orders available
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Payment Method Section -->
            <div id="payment-method" class="content-section p-8">
                <div class="flex justify-between items-center mb-6">
                    <h1 class="text-3xl font-bold text-gray-800">Manage Payment Methods</h1>
                    <button onclick="showAddPaymentMethodModal()" class="bg-adminPink text-white px-6 py-2 rounded-lg font-semibold hover:bg-pink-600 transition flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                        </svg>
                        Add New Payment Method
                    </button>
                </div>

                <!-- Payment Methods Table -->
                <div class="bg-white rounded-lg shadow-md overflow-x-auto border border-gray-100">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">PAYMENT METHOD ID</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">METHOD TYPE</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">STATUS</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% if (typeof paymentMethods !== 'undefined' && paymentMethods.length > 0) { %>
                                <% paymentMethods.forEach(method => { %>
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">#<%= method.Payment_Method_ID %></td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                            <span class="<%= method.Method_Type === 'Cash' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800' %> px-3 py-1 rounded-full text-xs font-semibold">
                                                <%= method.Method_Type %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                            <span class="bg-green-100 text-green-800 px-2 py-1 rounded-full text-xs font-semibold">Active</span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                            <button data-edit-id="<%= method.Payment_Method_ID %>" data-edit-type="<%= method.Method_Type %>" class="edit-payment-method-btn text-adminPink hover:text-pink-600 mr-4">Edit</button>
                                            <button data-delete-id="<%= method.Payment_Method_ID %>" class="delete-payment-method-btn text-red-600 hover:text-red-800">Delete</button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="px-6 py-12 text-center text-gray-500">
                                        No payment methods available
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- User Status Section -->
            <div id="user-status" class="content-section p-8">
                <div class="flex justify-between items-center mb-6">
                    <h1 class="text-3xl font-bold text-gray-800">User Login Status</h1>
                </div>

                <!-- User Status Table -->
                <div class="bg-white rounded-lg shadow-md overflow-x-auto border border-gray-100">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">USERNAME</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">STATUS</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% if (typeof loginStatus !== 'undefined' && loginStatus.length > 0) { %>
                                <% loginStatus.forEach(user => { %>
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= user.Username %></td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                            <span class="<%= user.Status === 'admin' ? 'bg-purple-100 text-purple-800' : user.Status === 'staff' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800' %> px-3 py-1 rounded-full text-xs font-semibold">
                                                <%= user.Status || 'user' %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                            <button data-edit-username="<%= user.Username %>" data-edit-status="<%= user.Status || 'user' %>" class="edit-user-status-btn text-adminPink hover:text-pink-600">Edit</button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3" class="px-6 py-12 text-center text-gray-500">
                                        No user login status available
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Add Payment Method Modal -->
            <div id="addPaymentMethodModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden z-50">
                <div class="flex items-center justify-center min-h-screen">
                    <div class="bg-white rounded-lg shadow-xl p-8 max-w-md w-full mx-4">
                        <h2 class="text-2xl font-bold text-gray-800 mb-6">Add New Payment Method</h2>
                        <form id="addPaymentMethodForm" method="POST" action="/admin/payment-method/add">
                            <div class="mb-4">
                                <label for="methodType" class="block text-sm font-medium text-gray-700 mb-2">Method Type</label>
                                <input type="text" id="methodType" name="methodType" required placeholder="Enter payment method name" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-adminPink focus:border-transparent">
                            </div>
                            <div class="flex gap-3">
                                <button type="submit" class="flex-1 bg-adminPink text-white px-4 py-2 rounded-lg font-semibold hover:bg-pink-600 transition">Add</button>
                                <button type="button" onclick="hideAddPaymentMethodModal()" class="flex-1 bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-semibold hover:bg-gray-300 transition">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Edit Payment Method Modal -->
            <div id="editPaymentMethodModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden z-50">
                <div class="flex items-center justify-center min-h-screen">
                    <div class="bg-white rounded-lg shadow-xl p-8 max-w-md w-full mx-4">
                        <h2 class="text-2xl font-bold text-gray-800 mb-6">Edit Payment Method</h2>
                        <form id="editPaymentMethodForm" method="POST">
                            <input type="hidden" id="editMethodId" name="methodId">
                            <div class="mb-4">
                                <label for="editMethodType" class="block text-sm font-medium text-gray-700 mb-2">Method Type</label>
                                <input type="text" id="editMethodType" name="methodType" required placeholder="Enter payment method name" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-adminPink focus:border-transparent">
                            </div>
                            <div class="flex gap-3">
                                <button type="submit" class="flex-1 bg-adminPink text-white px-4 py-2 rounded-lg font-semibold hover:bg-pink-600 transition">Update</button>
                                <button type="button" onclick="hideEditPaymentMethodModal()" class="flex-1 bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-semibold hover:bg-gray-300 transition">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Edit User Status Modal -->
            <div id="editUserStatusModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden z-50">
                <div class="flex items-center justify-center min-h-screen">
                    <div class="bg-white rounded-lg shadow-xl p-8 max-w-md w-full mx-4">
                        <h2 class="text-2xl font-bold text-gray-800 mb-6">Edit User Status</h2>
                        <form id="editUserStatusForm" method="POST" action="/admin/user-status/update">
                            <input type="hidden" id="editUsername" name="username">
                            <div class="mb-4">
                                <label for="editStatus" class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                                <select id="editStatus" name="status" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-adminPink focus:border-transparent">
                                    <option value="user">User</option>
                                    <option value="staff">Staff</option>
                                    <option value="admin">Admin</option>
                                </select>
                            </div>
                            <div class="flex gap-3">
                                <button type="submit" class="flex-1 bg-adminPink text-white px-4 py-2 rounded-lg font-semibold hover:bg-pink-600 transition">Update</button>
                                <button type="button" onclick="hideEditUserStatusModal()" class="flex-1 bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-semibold hover:bg-gray-300 transition">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function showSection(sectionId) {
            // Hide all sections
            document.querySelectorAll('.content-section').forEach(section => {
                section.classList.remove('active');
            });

            // Remove active class from all nav links
            document.querySelectorAll('.nav-link').forEach(link => {
                link.classList.remove('active');
            });

            // Show selected section
            document.getElementById(sectionId).classList.add('active');

            // Add active class to selected nav link
            document.getElementById('nav-' + sectionId).classList.add('active');
        }

        // Handle hash navigation
        window.addEventListener('load', function() {
            const hash = window.location.hash.substring(1);
            if (hash === 'products' || hash === 'orders' || hash === 'dashboard' || hash === 'payment-method' || hash === 'user-status') {
                showSection(hash);
            }
        });

        // Payment Method Modal Functions
        function showAddPaymentMethodModal() {
            document.getElementById('addPaymentMethodModal').classList.remove('hidden');
        }

        function hideAddPaymentMethodModal() {
            document.getElementById('addPaymentMethodModal').classList.add('hidden');
        }

        function showEditPaymentMethodModal(id, methodType) {
            document.getElementById('editMethodId').value = id;
            document.getElementById('editMethodType').value = methodType;
            document.getElementById('editPaymentMethodForm').action = `/admin/payment-method/update/${id}`;
            document.getElementById('editPaymentMethodModal').classList.remove('hidden');
        }

        function hideEditPaymentMethodModal() {
            document.getElementById('editPaymentMethodModal').classList.add('hidden');
        }

        function deletePaymentMethod(id) {
            if (confirm('Are you sure you want to delete this payment method?')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/admin/payment-method/delete/${id}`;
                document.body.appendChild(form);
                form.submit();
            }
        }

        // User Status Modal Functions
        function showEditUserStatusModal(username, status) {
            document.getElementById('editUsername').value = username;
            document.getElementById('editStatus').value = status || 'user';
            document.getElementById('editUserStatusModal').classList.remove('hidden');
        }

        function hideEditUserStatusModal() {
            document.getElementById('editUserStatusModal').classList.add('hidden');
        }

        // Event listeners for edit and delete buttons
        document.addEventListener('DOMContentLoaded', function() {
            // Edit button listeners for payment methods
            document.querySelectorAll('.edit-payment-method-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.getAttribute('data-edit-id');
                    const methodType = this.getAttribute('data-edit-type');
                    showEditPaymentMethodModal(id, methodType);
                });
            });

            // Delete button listeners for payment methods
            document.querySelectorAll('.delete-payment-method-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.getAttribute('data-delete-id');
                    deletePaymentMethod(id);
                });
            });

            // Edit button listeners for user status
            document.querySelectorAll('.edit-user-status-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const username = this.getAttribute('data-edit-username');
                    const status = this.getAttribute('data-edit-status');
                    showEditUserStatusModal(username, status);
                });
            });
        });
    </script>
</body>
</html>

