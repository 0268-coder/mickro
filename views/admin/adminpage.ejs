<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Mickro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        blush: '#FBD7D7',
                        rose: '#FCE5E5',
                        cherry: '#D94F5C',
                        cherryDark: '#BE3B48',
                        label: '#C64C5A',
                        placeholder: '#F5B8B8',
                        adminPink: '#EC4899',
                        adminRed: '#DC2626'
                    },
                    fontFamily: {
                        nunito: ['"Nunito"', 'sans-serif'],
                        pacifico: ['"Pacifico"', 'cursive']
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Pacifico&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <style>
        .content-section {
            display: none;
        }
        .content-section.active {
            display: block;
        }
        .nav-link.active {
            background-color: #EC4899;
            color: white;
        }
    </style>
</head>
<body class="min-h-screen bg-gray-50 font-nunito">
    <div class="flex h-screen overflow-hidden">
        <!-- Left Sidebar -->
        <aside class="w-64 bg-gray-100 flex flex-col">
            <!-- Logo Section -->
            <div class="p-8 border-b border-gray-200">
                <div class="flex flex-col items-center justify-center">
                    <div class="mb-3 transform hover:scale-105 transition-transform duration-300">
                        <img src="/images/logo_admin_micro.png" alt="Admin Logo" class="w-32 h-28 object-contain drop-shadow-lg">
                    </div>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="flex-1 p-4 space-y-2">
                <a href="#" onclick="showSection('dashboard'); return false;" class="nav-link active flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-200 transition" id="nav-dashboard">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                    <span class="font-medium">Dashboard</span>
                </a>
                <a href="admin/product" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-200 transition" id="nav-products">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                    <span class="font-medium">Products</span>
                </a>
                <a href="#" onclick="showSection('orders'); return false;" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-200 transition" id="nav-orders">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    <span class="font-medium">Orders</span>
                </a>
            </nav>

            <!-- Logout -->
            <div class="p-4 border-t border-gray-200">
                <a href="/login" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-200 transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                    <span class="font-medium">Logout</span>
                </a>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 overflow-y-auto bg-white">
            <!-- Dashboard Section -->
            <div id="dashboard" class="content-section active p-8">
                <h1 class="text-3xl font-bold text-gray-800 mb-2">Welcome, Admin!</h1>
                <p class="text-gray-600 mb-8">Here's a summary of your store's activity.</p>

                <!-- Summary Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                    <!-- Total Revenue Card -->
                    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-100">
                        <h3 class="text-gray-600 text-sm font-medium mb-2">Total Revenue</h3>
                        <p class="text-3xl font-bold text-adminPink mb-1">฿0</p>
                        <p class="text-sm text-green-600">+0% this month</p>
                    </div>

                    <!-- New Orders Card -->
                    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-100">
                        <h3 class="text-gray-600 text-sm font-medium mb-2">New Orders</h3>
                        <p class="text-3xl font-bold text-adminPink mb-1">0</p>
                        <p class="text-sm text-green-600">+0 new today</p>
                    </div>

                    <!-- New Users Card -->
                    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-100">
                        <h3 class="text-gray-600 text-sm font-medium mb-2">New Users</h3>
                        <p class="text-3xl font-bold text-adminPink mb-1">0</p>
                        <p class="text-sm text-green-600">+0 new today</p>
                    </div>

                    <!-- Products Card -->
                    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-100">
                        <h3 class="text-gray-600 text-sm font-medium mb-2">Products</h3>
                        <p class="text-3xl font-bold text-adminPink mb-1">0</p>
                        <p class="text-sm text-gray-500">active products</p>
                    </div>
                </div>
            </div>

            <!-- Products Section -->
            <div id="products" class="content-section p-8">
                <div class="flex justify-between items-center mb-6">
                    <h1 class="text-3xl font-bold text-gray-800">Manage Products</h1>
                    <button class="bg-adminPink text-white px-6 py-2 rounded-lg font-semibold hover:bg-pink-600 transition flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                        </svg>
                        Add New Product
                    </button>
                </div>

                <!-- Products Table -->
                <div class="bg-white rounded-lg shadow-md overflow-hidden border border-gray-100">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">PRODUCT</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">PRICE</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">STOCK</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">STATUS</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <!-- Empty state -->
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                                    No products available
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Orders Section -->
            <div id="orders" class="content-section p-8">
                <h1 class="text-3xl font-bold text-gray-800 mb-6">Manage Orders</h1>

                <!-- Orders Table -->
                <div class="bg-white rounded-lg shadow-md overflow-hidden border border-gray-100">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">ORDER ID</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">DATE</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">STATUS</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">TOTAL</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <!-- Empty state -->
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                                    No orders available
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <script>
        function showSection(sectionId) {
            // Hide all sections
            document.querySelectorAll('.content-section').forEach(section => {
                section.classList.remove('active');
            });

            // Remove active class from all nav links
            document.querySelectorAll('.nav-link').forEach(link => {
                link.classList.remove('active');
            });

            // Show selected section
            document.getElementById(sectionId).classList.add('active');

            // Add active class to selected nav link
            document.getElementById('nav-' + sectionId).classList.add('active');
        }

        // Handle hash navigation
        window.addEventListener('load', function() {
            const hash = window.location.hash.substring(1);
            if (hash === 'products' || hash === 'orders' || hash === 'dashboard') {
                showSection(hash);
            }
        });
    </script>
</body>
</html>

