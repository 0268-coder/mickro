<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Product</title>
    <!-- Load Tailwind CSS for easy styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom styles for better aesthetics */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6;
        }
    </style>
</head>
<body class="p-8 md:p-12">

    <div class="max-w-xl mx-auto bg-white p-6 md:p-8 shadow-2xl rounded-xl">
        <h1 class="text-3xl font-bold text-gray-800 mb-6 border-b pb-2">Create New Product</h1>

        <!-- The HTML Form Structure -->
        <!-- 
            Action: The URL where the data will be sent (e.g., your Express route)
            Method: POST to send data securely in the request body
        -->
        <form action="/admin/product/add" method="POST" class="space-y-4">
            
            <!-- Product Name -->
            <div>
                <label for="productName" class="block text-sm font-medium text-gray-700">Product Name</label>
                <input type="text" id="productName" name="name" required
                       class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 transition duration-150">
            </div>

            <!-- Product Price -->
            <div>
                <label for="productPrice" class="block text-sm font-medium text-gray-700">Price (USD)</label>
                <input type="number" step="0.01" min="0" id="productPrice" name="price" required
                       class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 transition duration-150">
            </div>

            <div class="grid grid-cols-3 gap-4">
                <!-- Length -->
                <div>
                    <label for="productLength" class="block text-sm font-medium text-gray-700">Length (cm)</label>
                    <input type="number" step="0.01" min="0" id="productLength" name="length" required
                           class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 transition duration-150">
                </div>

                <!-- Height -->
                <div>
                    <label for="productHeight" class="block text-sm font-medium text-gray-700">Height (cm)</label>
                    <input type="number" step="0.01" min="0" id="productHeight" name="height" required
                           class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 transition duration-150">
                </div>

                <!-- Width -->
                <div>
                    <label for="productWidth" class="block text-sm font-medium text-gray-700">Width (cm)</label>
                    <input type="number" step="0.01" min="0" id="productWidth" name="width" required
                           class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 transition duration-150">
                </div>
            </div>

            <!-- Image URL/Path (Optional) -->
            <div>
                <label for="productImage" class="block text-sm font-medium text-gray-700">Image URL (Optional)</label>
                <input type="text" id="productImage" name="image" 
                       class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 transition duration-150"
                       placeholder="e.g., /images/product-1.jpg">
            </div>

            <button type="submit"
                    class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg shadow-md transition duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                Add Product
            </button>
        </form>
    </div>
    <a href="/admin">back</a>
</body>
</html>